@model LetsGoLetsGetJacked.Models.Exercise
@{
    ViewData["Title"] = "Edit Exercise";
}
<h1>Edit Exercise</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group mb-3">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="MuscleGroup" class="control-label"></label>
        <input asp-for="MuscleGroup" class="form-control" />
        <span asp-validation-for="MuscleGroup" class="text-danger"></span>
    </div>
    <button type="submit" class="bnt bnt-primary">Save Changes</button>
    <a asp-action="Index" class="bnt bnt-secondary">Cancel</a>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}