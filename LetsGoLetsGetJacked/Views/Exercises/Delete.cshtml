@model LetsGoLetsGetJacked.Models.Exercise
@{
    ViewData["Title"] = "Delete Exercise";
}
<h1>Delete Exercise</h1>
<h3>Are you sure you want to delete this exercise?</h3>
<form asp-action="Delete" method="post">
    <div class="card p-3 mb-3">
        <dl class="row">
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">MuscleGroup</dt>
            <dd class="col-sm-9">@Model.MuscleGroup</dd>
        </dl>
    </div>
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>