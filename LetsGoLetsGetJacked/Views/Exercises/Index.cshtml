@model IEnumerable<LetsGoLetsGetJacked.Models.Exercise>
@{
    ViewData["Title"] = "My Exercises";
}
<h1>My Exercises</h1>
<p>
    <a asp-action="Create" class="btn btn-primary">Add Exercise</a>
</p>
@if (!Model.Any())
{
    <p>You have no exercises</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Muscle Group</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var exercise in Model)
            {
                <tr>
                    <td>@exercise.Name</td>
                    <td>@exercise.MuscleGroup</td>
                </tr>
            }
        </tbody>
    </table>
}