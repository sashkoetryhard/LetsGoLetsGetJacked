@model LetsGoLetsGetJacked.Models.WorkoutSet
@{
    ViewData["Title"] = "Add Set";
}
<h1>Add Set</h1>
<p>Workout: @ViewData["WorkoutName"]</p>
<form asp-action="AddSet" method="post">
    <input type="hidden" asp-for="WorkoutSessionId" />
    <div class="form-group mb-3">
        <label asp-for="ExerciseId" class="control-label">Exercise</label>
        <select asp-for="ExerciseId" asp-items="ViewBag.Exercises" class="form-control">
            <option value="">-- Select Exercise --</option>
        </select>
        <span asp-validation-for="ExerciseId" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="SetNumber" class="control-label">Set Number</label>
        <input asp-for="SetNumber" type="number" class="form-control" />
        <span asp-validation-for="SetNumber" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Weight" class="control-label">Weight</label>
        <input asp-for="Weight" type="number" step="0.5" class="form-control" />
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Reps" class="control-label">Reps</label>
        <input asp-for="Reps" type="number" class="form-control" />
        <span asp-validation-for="Reps" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save Set</button>
    <a asp-action="Details" asp-route-id="@Model.WorkoutSessionId" class="btn btn-secondary">Cancel</a>
</form>
@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}